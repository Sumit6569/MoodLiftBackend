# ──────────────────────────────────────────────
# MoodLift Backend - Docker Environment Variables
# ──────────────────────────────────────────────

# JWT Secret
JWT_SECRET=SECRET_KEY

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# PayPal Configuration (optional - payment service)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email Configuration (optional - session service)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# SendGrid (optional - user/session services)
SENDGRID_API_KEY=
