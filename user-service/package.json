{
  "name": "user-service",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend with build step",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node dist/index.cjs",
    "prebuild": "node -e \"const fs = require('fs'); if (!fs.existsSync('dist')) fs.mkdirSync('dist', { recursive: true });\"",
    "build": "npx esbuild src/index.js --bundle --platform=node --outfile=dist/index.cjs --format=cjs --minify --external:mongoose --external:bcryptjs --external:express --external:express-rate-limit --external:compression --external:cors --external:dotenv --external:helmet --external:jsonwebtoken --external:morgan --external:nodemailer --external:uuid",
    "postbuild": "echo '✅ Build completed successfully'",
    "postinstall": "npm run build",
    "clean": "rm -rf dist",
    "deploy": "npm run clean && npm run build && echo '🚀 Build ready for deployment'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.1",
    "nodemailer": "^6.9.15",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "esbuild": "^0.25.10"
  }
}
