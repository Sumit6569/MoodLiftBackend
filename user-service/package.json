{
  "name": "user-service",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend with build step",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prebuild": "node -e \"require('fs').mkdirSync('dist', {recursive: true})\"",
    "build": "npx esbuild src/index.js --bundle --platform=node --outdir=dist --minify --packages=external",
    "deploy": "npm run clean && npm run build && echo Build ready for deployment",
    "postbuild": "echo Build completed successfully"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.1",
    "nodemailer": "^6.9.15",
    "uuid": "^11.1.0",
    "esbuild": "^0.25.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
