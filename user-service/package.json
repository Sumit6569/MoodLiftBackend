{
  "name": "user-service",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js --exec node src/index.js",
    "start": "node dist/index.js",
    "start:dev": "node src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node build.config.js",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true}); console.log('Cleaned dist directory');\"",
    "prebuild": "npm run clean",
    "postbuild": "echo \"✅ Build completed! Files ready in dist/ directory\"",
    "deploy": "npm run build && echo \"🚀 Ready for deployment\"",
    "docker:build": "docker build -t moodlift-user-service .",
    "docker:run": "docker run -p 3001:3001 --env-file .env moodlift-user-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.10",
    "nodemon": "^3.0.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.1",
    "nodemailer": "^6.9.15",
    "uuid": "^11.1.0"
  }
}
